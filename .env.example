# Ethereum RPC URL (required)
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Bundler private key (required) - must have ETH on Sepolia
BUNDLER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Chain ID for Sepolia
CHAIN_ID=11155111

# Other configuration (optional)
POOL_SIZE=1
MAX_VERIFICATION=100